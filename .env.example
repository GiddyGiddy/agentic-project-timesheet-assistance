# Azure OpenAI deployment used to propose project hours.
# Use the resource root, e.g. https://<resource>.openai.azure.com (no /openai/v1 suffix).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Microsoft Entra tenant and app registration that owns the Microsoft 365 data.
# The Work IQ sign-in is a delegated browser flow and does not use a client secret.
TENANT_ID=
CLIENT_ID=
CLIENT_SECRET=

# IANA time zone used for "today", the day window and the scheduler.
TIMEZONE=Europe/Berlin

# Optional path overrides (defaults shown).
# For isolated per-user storage, set TIMESHEET_DATA_DIR in the process environment,
# not this file. That mode deliberately ignores the working-directory .env.
# Packaged builds select %LOCALAPPDATA%\TimesheetAssistant automatically.
# DATABASE_URL=sqlite:///data/timesheet.db
# CHECKPOINT_PATH=data/checkpoints.db
# MCP_CONFIG_PATH=config/mcp_servers.json
# PROJECTS_REGISTRY_PATH=config/projects_registry.json
# TEMPLATE_PATH=data/templates/timesheet_template.xlsx
# OUTPUT_DIR=output
